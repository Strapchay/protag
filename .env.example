# Aion Kernel environment template.
# Copy to one of:
# - <project>/.env for project-specific overrides
# - ~/.config/aion-kernel/.env for user-wide defaults
# - <kernel>/.env for local kernel development defaults
#
# Values below are intentionally generic. Replace every *_KEY / *_SECRET /
# *_TOKEN placeholder with credentials for your own gateway/provider setup.

# ---------------------------------------------------------------------------
# Orchestrator
# ---------------------------------------------------------------------------
AION_ORCHESTRATOR_HOST=127.0.0.1
AION_ORCHESTRATOR_PORT=50051
AION_ORCHESTRATOR_CORE_ADDR=127.0.0.1:50051
AION_ORCHESTRATOR_ADDR=127.0.0.1:50051
AION_ORCHESTRATOR_LISTEN_ADDR=127.0.0.1:50051
AION_LOG_LEVEL=info
AION_KERNEL_ROOT=/absolute/path/to/aion-kernel/kernel

AION_DAG_FILE=.aion/runs/current/dag.bin
AION_WAL_FILE=.aion/runs/current/orchestrator.wal
AION_MAX_ACTIVE_NODES=200
AION_FLUSH_DEADLINE_MS=50

# ---------------------------------------------------------------------------
# Health and execution
# ---------------------------------------------------------------------------
AION_HEARTBEAT_TIMEOUT_SEC=120
AION_PROGRESS_TIMEOUT_SEC=1800
AION_EXTERNAL_ACTIVITY_STALE_TIMEOUT_SEC=45
AION_EXTERNAL_ACTIVITY_MAX_DURATION_SEC=1800
AION_COORDINATOR_PLANNER_START_TIMEOUT_SEC=30
AION_COORDINATOR_PLANNER_FIRST_REQUEST_TIMEOUT_SEC=60
AION_COORDINATOR_PLANNER_ARTIFACT_TIMEOUT_SEC=300

# gateway: Pi traffic is routed through the local Aion inference gateway.
# none: Pi talks directly to the configured provider.
AION_EXECUTION_MODE=gateway
AION_EXECUTION_MAX_CONCURRENT_REQUESTS=1
AION_EXECUTION_REQUEST_QUEUE_TIMEOUT_SEC=600

# ---------------------------------------------------------------------------
# Local inference gateway
# ---------------------------------------------------------------------------
AION_INFERENCE_GATEWAY_ENABLED=true
AION_INFERENCE_GATEWAY_LISTEN_ADDR=127.0.0.1:50151
AION_INFERENCE_GATEWAY_URL=http://127.0.0.1:50151
AION_INFERENCE_GATEWAY_KEY=replace-with-local-gateway-key
AION_INFERENCE_GATEWAY_TARGET_PROFILE=forge
AION_INFERENCE_GATEWAY_MAX_RETRIES=2
AION_INFERENCE_GATEWAY_RETRY_BASE_DELAY_MS=1000
AION_INFERENCE_GATEWAY_RETRY_MAX_DELAY_MS=30000
AION_INFERENCE_GATEWAY_UPSTREAM_TIMEOUT_SEC=300

# Mandatory domain-agent isolation (Bubblewrap, fail-closed)
AION_ISOLATION_BACKEND=bubblewrap
AION_ISOLATION_RUNTIME_BASE=/tmp/aion-isolation
AION_ISOLATION_NETWORK=isolated

# ---------------------------------------------------------------------------
# Resource governance
# ---------------------------------------------------------------------------
# disabled: best for local development without systemd/cgroup setup.
# systemd: use installed delegated cgroup service.
# direct: write directly to cgroupfs when permissions allow it.
AION_CGROUPS_ENABLED=false
AION_CGROUPS_MODE=disabled
AION_CGROUPS_BASE_PATH=/sys/fs/cgroup/aion
AION_CGROUPS_MEMORY_MAX_MB=2048
AION_CGROUPS_PIDS_MAX=256

# ---------------------------------------------------------------------------
# Inference profiles
# ---------------------------------------------------------------------------
# Profile names are Aion codenames:
# - oracle: architect/coordinator-grade reasoning
# - forge: domain-agent implementation work
# - glimmer/ember/lyric: reserved alternates
# - harbor: fallback profile
#
# Provider/model/endpoint values below are throwaway placeholders. Use your own
# provider adapter name, model identifier, endpoint URL, and credential env key.

AION_PROFILE_ORACLE_PROVIDER=provider-alpha
AION_PROFILE_ORACLE_MODEL=model-alpha
AION_PROFILE_ORACLE_ENDPOINT=https://provider-alpha.invalid/v1
AION_PROFILE_ORACLE_ENV_KEY=PROVIDER_ALPHA_KEY
AION_PROFILE_ORACLE_API_KEY=replace-with-provider-alpha-key

AION_PROFILE_FORGE_PROVIDER=provider-beta
AION_PROFILE_FORGE_MODEL=model-beta
AION_PROFILE_FORGE_ENDPOINT=https://provider-beta.invalid/v1
AION_PROFILE_FORGE_ENV_KEY=PROVIDER_BETA_KEY
AION_PROFILE_FORGE_API_KEY=replace-with-provider-beta-key

AION_PROFILE_GLIMMER_PROVIDER=provider-gamma
AION_PROFILE_GLIMMER_MODEL=model-gamma
AION_PROFILE_GLIMMER_ENDPOINT=https://provider-gamma.invalid/v1
AION_PROFILE_GLIMMER_ACCOUNT_ENV_KEY=PROVIDER_GAMMA_ACCOUNT
AION_PROFILE_GLIMMER_ACCOUNT_ID=replace-with-provider-gamma-account
AION_PROFILE_GLIMMER_API_KEY_ENV_KEY=PROVIDER_GAMMA_KEY
AION_PROFILE_GLIMMER_API_KEY=replace-with-provider-gamma-key

AION_PROFILE_EMBER_PROVIDER=provider-delta
AION_PROFILE_EMBER_MODEL=model-delta
AION_PROFILE_EMBER_ENDPOINT=https://provider-delta.invalid/v1
AION_PROFILE_EMBER_ENV_KEY=PROVIDER_DELTA_KEY
AION_PROFILE_EMBER_API_KEY=replace-with-provider-delta-key

AION_PROFILE_LYRIC_PROVIDER=provider-epsilon
AION_PROFILE_LYRIC_MODEL=model-epsilon
AION_PROFILE_LYRIC_ENDPOINT=https://provider-epsilon.invalid/v1
AION_PROFILE_LYRIC_ENV_KEY=PROVIDER_EPSILON_KEY
AION_PROFILE_LYRIC_API_KEY=replace-with-provider-epsilon-key

AION_PROFILE_HARBOR_PROVIDER=provider-harbor
AION_PROFILE_HARBOR_MODEL=model-harbor
AION_PROFILE_HARBOR_ENDPOINT=https://provider-harbor.invalid/v1

AION_COORDINATOR_PROFILE=oracle
AION_DOMAIN_AGENTS_PROFILE=forge

# ---------------------------------------------------------------------------
# Agent runtime
# ---------------------------------------------------------------------------
AION_AGENT_SESSION_DIR=.aion/sessions
AION_MAX_AGENTS=4
AION_AGENT_COMMAND_PATH=pi
# Use absolute paths when running Aion against external project directories.
AION_AGENT_SKILL_PATH=/absolute/path/to/aion-kernel/kernel/skills/orchestrator-cli
AION_PI_GATEWAY_EXTENSION_PATH=/absolute/path/to/aion-kernel/kernel/install/pi/extensions/aion-gateway-provider.ts

# ---------------------------------------------------------------------------
# Semantic memory
# ---------------------------------------------------------------------------
AION_MEMORY_ENABLED=false
AION_MEMORY_READ_ENABLED=false
AION_MEMORY_BACKEND_PROFILE=memory-backend
AION_MEMORY_BACKEND_MODEL=memory-model
AION_MEMORY_BACKEND_ENDPOINT=http://127.0.0.1:59999/v1
AION_MEMORY_RELEVANCE_THRESHOLD=0.7
